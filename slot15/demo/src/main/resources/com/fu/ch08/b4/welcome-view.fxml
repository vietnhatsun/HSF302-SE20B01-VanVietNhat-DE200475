<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fu.ch08.b4.WelcomeController"
      alignment="CENTER" spacing="15.0" prefWidth="360.0" prefHeight="200.0">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>
    <Label fx:id="lblWelcome" style="-fx-font-size: 16px; -fx-font-weight: bold;" wrapText="true"/>
    <Button text="Đăng xuất" onAction="#handleLogout"/>
</VBox>
